<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="update2025-01-11_create_candidates_table" author="v.semerkov" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="candidates" schemaName="public"/>
            </not>
        </preConditions>

        <createTable tableName="candidates" schemaName="public">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="date_of_birth" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="sex" type="CHAR(1)">
                <constraints nullable="false"/>
            </column>

            <column name="destiny_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>